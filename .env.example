# SafiHub Database Configuration (Neon PostgreSQL)

# Active Database URLs
DATABASE_URL="postgresql://user:password@ep-cold-rain-b2q4m2ga.c-6.eu-central-1.aws.neon.tech/neondb_dev?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://user:password@ep-cold-rain-b2q4m2ga-pooler.c-6.eu-central-1.aws.neon.tech/neondb_dev?sslmode=require&channel_binding=require"

# Development Database (Separate Neon dev database)
DATABASE_URL_DEV="postgresql://user:password@ep-cold-rain-b2q4m2ga.c-6.eu-central-1.aws.neon.tech/neondb_dev?sslmode=require&channel_binding=require"
DATABASE_URL_DEV_POOLED="postgresql://user:password@ep-cold-rain-b2q4m2ga-pooler.c-6.eu-central-1.aws.neon.tech/neondb_dev?sslmode=require&channel_binding=require"

# Production Database (Neon main database)
DATABASE_URL_PROD="postgresql://user:password@ep-cold-rain-b2q4m2ga.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_PROD_POOLED="postgresql://user:password@ep-cold-rain-b2q4m2ga-pooler.c-6.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Storage — S3-compatible object storage (Cloudflare R2 / Neon)
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
S3_BUCKET="safihub"

# Auth (better-auth)
# REQUIRED in production (must be >= 32 random characters). Server startup fails if unset.
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="SafiHub <no-reply@example.com>"
EMAIL_DOMAIN="example.com"

# Sentry Error Tracking & Monitoring
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# R2 S3 API credentials (from R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ACCOUNT_ID=your_account_id
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=/api/storage                          # Internal storage proxy or your custom CDN URL
STORAGE_HOSTNAME=                                        # Optional: custom CDN hostname for Next.js image optimization

# PostHog Analytics & Monitoring (Server-Side Events)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# Upstash Redis (deployment-wide rate limiting for login/register/checkout)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# WhatsApp Cloud API (Meta Graph API v23.0)
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="change-this-to-a-secure-random-32-char-verify-token"
WHATSAPP_APP_SECRET=""

# Inngest background jobs
INNGEST_EVENT_KEY=your_event_key
INNGEST_SIGNING_KEY=your_signing_key

# Interactive Map (MapLibre GL)
# Plan style defaults to OpenFreeMap (free, no key). MapTiler key is optional and only loaded when switching to Satellite.
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
NEXT_PUBLIC_MAPTILER_KEY=""
